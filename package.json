{
  "name": "yoyo",
  "private": true,
  "type": "module",
  "description": "个人桌宠导演。用 dsh-pet 的官方接口表演，台词、语气、语音和天气都在这里；上下文交给 ctx。",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "yoyo": "./bin/yoyo.js"
  },
  "scripts": {
    "start": "node src/main.ts",
    "once": "node src/main.ts --once",
    "bake": "node src/main.ts --bake",
    "yoyo": "node bin/yoyo.js",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint --deny-warnings",
    "test": "vp test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check --deny-warnings && vp test"
  },
  "dependencies": {
    "@modelctx-ai/ctx": "^0.2.0",
    "@modelctx-ai/ctx-gateway": "^0.2.0",
    "@modelctx-ai/ctx-mcp": "^0.2.0",
    "@modelctx-ai/ctx-models": "^0.2.0",
    "@modelctx-ai/ctx-protocol": "^0.2.0",
    "@modelctx-ai/ctx-sqlite": "^0.2.0",
    "@yoyo/dsh-pet": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "ai": "^7.0.150",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
