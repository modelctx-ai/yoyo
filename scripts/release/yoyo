#!/bin/bash
# yoyo 安装包的启动脚本，放在 yoyo.app/Contents/Resources/yoyo。用包里带的 Node、桌宠（dsh-pet 独立模式和 Electron）、
# ffmpeg、whisper-cli 和按键助手，机器上不用另外装什么。app 的外壳用它起常驻进程；在终端里用时链到 PATH 上。
# 配置和数据都在 ~/.yoyo（YOYO_HOME 可以换），换新版本时整个 app 替换掉就行。
set -euo pipefail

# 包所在目录；从 PATH 上的符号链接调用也认得出
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ "$self" == /* ]] || self="$dir/$self"
done
root="$(cd -P "$(dirname "$self")" && pwd)"
lib="$root/lib"
node="$lib/node/bin/node"

home="${YOYO_HOME:-$HOME/.yoyo}"
export YOYO_CONFIG="${YOYO_CONFIG:-$home/config.json}"
export YOYO_HOTKEY="${YOYO_HOTKEY:-$lib/bin/yoyo-hotkey}"
export DSH_PET_ELECTRON_PATH="${DSH_PET_ELECTRON_PATH:-$lib/electron/Electron.app/Contents/MacOS/Electron}"
# 桌宠经 yoyo 的 pet 入口开：先按配置排好右键菜单，再交给包里打过补丁的 dsh-pet
export YOYO_PET_ENTRY="${YOYO_PET_ENTRY:-$lib/dsh-pet/lib/standalone.js}"
# 录音的 ffmpeg、听写的 whisper-cli，以及 MCP 服务器和搜索脚本用的 node、npx，都先找包里的
export PATH="$lib/node/bin:$lib/bin:$PATH"
# 在 yoyo.app 里：管理页在 app 的窗口里打开，yoyo update 知道换哪个 app
case "$root" in
  *.app/Contents/Resources) export YOYO_APP="${root%/Contents/Resources}" ;;
esac

# 从浏览器下载的 dmg 里拖出来的文件带隔离属性，包里自己编的程序没经过 Apple 公证，第一次运行会被系统拦下。
# 只清这个目录里的。
if command -v xattr >/dev/null && xattr -p com.apple.quarantine "$node" >/dev/null 2>&1; then
  xattr -dr com.apple.quarantine "$root" 2>/dev/null || true
fi

usage() {
  cat <<EOF
yoyo $(cat "$lib/VERSION" 2>/dev/null || echo '')

yoyo start          桌宠没开就先开桌宠，再常驻；Control+C 一起停（平时打开 yoyo.app 就是这个）
yoyo once           只说一句
yoyo bake           把固定台词预先合成好
yoyo pet [选项]     只开桌宠（dsh-pet 独立模式），--check 看环境
yoyo update check   看有没有新版本；yoyo update install 换上
yoyo <领域> [动作]  命令行，见下面

配置：$YOYO_CONFIG
EOF
}

# 第一次运行：把示例配置放到数据目录，填好再来
ensure_config() {
  [ -f "$YOYO_CONFIG" ] && return 0
  mkdir -p -m 700 "$home"
  mkdir -p "$(dirname "$YOYO_CONFIG")"
  cp "$root/config.example.json" "$YOYO_CONFIG"
  chmod 600 "$YOYO_CONFIG"
  echo "示例配置放到了 $YOYO_CONFIG"
  echo "填上 Fish Audio 的 speech.apiKey 和 speech.referenceId，再启动一次。"
  exit 1
}

# 听写模型随包带着，第一次用时就不用再下载
seed_model() {
  local model="$home/models/ggml-tiny.bin"
  if [ -s "$model" ] || [ ! -s "$lib/models/ggml-tiny.bin" ]; then
    return 0
  fi
  mkdir -p -m 700 "$home" "$home/models"
  cp "$lib/models/ggml-tiny.bin" "$model.tmp"
  mv "$model.tmp" "$model"
}

# 桌宠独立模式在跑：运行状态文件里的进程还活着
pet_running() {
  local runtime="${YOYO_PET_RUNTIME:-${DSH_HOME:-$HOME/.dsh}/dsh-pet/standalone-runtime.json}"
  [ -f "$runtime" ] || return 1
  local pid
  pid="$("$node" -e 'try { process.stdout.write(String(JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).pid ?? "")) } catch {}' "$runtime")"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

pet_pid=""
stop_pet() {
  if [ -n "$pet_pid" ] && kill -0 "$pet_pid" 2>/dev/null; then
    kill -TERM "$pet_pid" 2>/dev/null || true
    wait "$pet_pid" 2>/dev/null || true
  fi
}

# 桌宠没开就在后台开一个，等它写好运行状态；输出记在数据目录的 pet.log
start_pet() {
  if pet_running; then
    echo "桌宠已经开着"
    return 0
  fi
  mkdir -p -m 700 "$home"
  "$node" "$lib/yoyo/pet.mjs" >"$home/pet.log" 2>&1 &
  pet_pid=$!
  trap stop_pet EXIT
  for _ in $(seq 1 60); do
    if pet_running; then
      echo "桌宠开好了"
      return 0
    fi
    if ! kill -0 "$pet_pid" 2>/dev/null; then
      pet_pid=""
      echo "桌宠没开起来，看 $home/pet.log" >&2
      exit 1
    fi
    sleep 0.5
  done
  echo "桌宠 30 秒还没开好，看 $home/pet.log" >&2
  exit 1
}

# 常驻进程放在后台等着：脚本自己收到 TERM、HUP（例如关掉终端窗口）也能转给它，收尾后再关桌宠
daemon_pid=""
run_daemon() {
  "$node" "$lib/yoyo/main.mjs" &
  daemon_pid=$!
  trap 'kill -TERM "$daemon_pid" 2>/dev/null || true' INT TERM HUP
  local status=0
  while kill -0 "$daemon_pid" 2>/dev/null; do
    if wait "$daemon_pid"; then status=0; else status=$?; fi
  done
  return "$status"
}

case "${1:-}" in
  start)
    ensure_config
    seed_model
    start_pet
    run_daemon
    ;;
  once | bake)
    ensure_config
    seed_model
    exec "$node" "$lib/yoyo/main.mjs" "--$1"
    ;;
  pet)
    shift
    exec "$node" "$lib/yoyo/pet.mjs" "$@"
    ;;
  "" | -h | --help)
    usage
    echo
    exec "$node" "$lib/yoyo/cli.mjs"
    ;;
  *)
    exec "$node" "$lib/yoyo/cli.mjs" "$@"
    ;;
esac
