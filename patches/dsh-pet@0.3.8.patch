index 0000000000000000000000000000000000000000..fe623b1a1acf4e0c5b1b971bcc93d64bda991f13
--- /dev/null
+++ b/runtime/electron-helper/yoyo-menu.js
@@ -0,0 +1,28 @@
+/**
+ * yoyo 补丁，不在上游：yoyo 仓库的 patches/dsh-pet@*.patch 在安装时打进来。
+ *
+ * 按主进程转来的 yoyoMenu 参数（取自环境变量 YOYO_PET_MENU）整理右键菜单：hide 按 action 去掉自带的工具项，
+ * top 按 owner 把第三方项提到第一层、不再收进「更多」。例：{"hide":["open-site","show-balance"],"top":["yoyo"]}。
+ * 没有这个参数或不是合法 JSON 时原样返回，菜单和上游一样。
+ */
+'use strict';
+
+function yoyoArrangeMenu(tools, items) {
+  const list = Array.isArray(items) ? items : [];
+  let spec = null;
+  try {
+    spec = JSON.parse(params.get('yoyoMenu') || 'null');
+  } catch {
+    spec = null;
+  }
+  if (!spec || typeof spec !== 'object') return { top: [], tools, items: list };
+  const hide = new Set(Array.isArray(spec.hide) ? spec.hide : []);
+  const owners = new Set(Array.isArray(spec.top) ? spec.top : []);
+  return {
+    top: list
+      .filter((item) => owners.has(item.owner))
+      .map((item) => ({ label: item.label, action: 'third-party', owner: item.owner })),
+    tools: tools.filter((node) => !hide.has(node.action)),
+    items: list.filter((item) => !owners.has(item.owner)),
+  };
+}
